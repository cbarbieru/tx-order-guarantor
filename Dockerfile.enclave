# syntax=docker/dockerfile:1
#
# SGX image for the tog-enclave (Fortanix EDP).
#
# Transport is PLAINTEXT and the enclave always presents a dev STUB attestation —
# so no Enclave Manager, no mbedtls, and no AESM are needed. It still runs in a
# REAL enclave (the runtime needs the kernel SGX driver passed in). Note: EDP
# enclaves do NOT inherit the container environment, so behaviour is baked into
# the build, not set via `-e` (TOG_* env vars don't reach the enclave).
#
# This is a STARTING POINT — iterate on your Linux SGX box. It cannot be built or
# run on an Apple-Silicon Mac (no SGX, ARM CPU). Build/run on an SGX2 host
# (e.g. Azure DCsv3/DCdsv3).
#
#   docker build -f Dockerfile.enclave -t tog-enclave .
#   docker run --rm --device /dev/sgx_enclave -p 1546:1546 tog-enclave
#   # then, from the same host:  cargo run -p tog-client -- --addr 127.0.0.1:1546 demo

# ── Stage 1: build the enclave + convert/sign it ────────────────────────────
# Fortanix EDP requires Rust nightly.
FROM rustlang/rust:nightly-bookworm AS build

# Build deps for the Fortanix tools (aesm-client → protobuf) and signing (openssl).
RUN apt-get update && apt-get install -y --no-install-recommends \
        build-essential pkg-config libssl-dev protobuf-compiler \
    && rm -rf /var/lib/apt/lists/*

# Fortanix EDP toolchain (the base image's default toolchain is nightly).
RUN rustup target add x86_64-fortanix-unknown-sgx \
    && cargo install fortanix-sgx-tools sgxs-tools

WORKDIR /src
COPY . .

# Build the enclave for the SGX target. Plaintext transport → no extra features
# and no TLS/attestation deps required.
RUN cargo build --release -p tog-enclave --target x86_64-fortanix-unknown-sgx

# Convert ELF -> .sgxs using the layout from Cargo.toml's fortanix-sgx metadata.
RUN ftxsgx-elf2sgxs \
        target/x86_64-fortanix-unknown-sgx/release/tog-enclave \
        --heap-size 2147483648 --stack-size 262144 --threads 16 --debug \
        --output /tog-enclave.sgxs

# Dev signing key — DO NOT ship this throwaway key; sign with your own for prod.
# SGX requires a 3072-bit RSA key with public exponent 3.
RUN openssl genrsa -3 -out /signing-key.pem 3072 \
    && sgxs-sign --key /signing-key.pem /tog-enclave.sgxs /tog-enclave.sig

# ── Stage 2: slim runtime (just the Fortanix runner) ────────────────────────
# debian-slim (~30 MB) keeps a shell, so during bring-up you can `docker exec`
# in to diagnose enclave-load issues. The runner loads the enclave via
# /dev/sgx_enclave directly (glibc only) — no Intel PSW/libsgx needed for a
# plaintext, stub-attested run, which is what drops the bulk of the old 135 MB.
# If the runner reports a missing .so at startup, `ldd` it inside and
# `apt-get install` that lib (or fall back to ubuntu:22.04 + libsgx-urts).
FROM debian:bookworm-slim AS runtime

COPY --from=build /usr/local/cargo/bin/ftxsgx-runner /usr/local/bin/ftxsgx-runner
COPY --from=build /tog-enclave.sgxs /tog-enclave.sgxs
COPY --from=build /tog-enclave.sig  /tog-enclave.sig

EXPOSE 1546
# Pass /dev/sgx_enclave into the container at run time, and publish :1546 to reach
# it from the host. On FLC hardware (which EDP requires) no AESM is needed to
# launch. The stub attestation is always-on (baked into the binary), not an env.
ENTRYPOINT ["ftxsgx-runner", "/tog-enclave.sgxs"]
