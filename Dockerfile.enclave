# syntax=docker/dockerfile:1
#
# SGX runtime image for the tog-enclave (Fortanix EDP).
#
# This is a STARTING POINT, not a validated build — it must be iterated on your
# Linux SGX box. It cannot be built or run on the Apple-Silicon dev Mac (no SGX
# hardware, ARM CPU). Build/run on an SGX2 host (e.g. Azure DCsv3/DCdsv3).
#
#   docker build -f Dockerfile.enclave -t tog-enclave .
#   docker run --rm \
#       --device /dev/sgx_enclave --device /dev/sgx_provision \
#       -v /var/run/aesmd:/var/run/aesmd \
#       -e TOG_ENCLAVE_BIND=0.0.0.0:1546 \
#       -e ENCLAVE_MANAGER_URL=... \
#       -p 1546:1546 \
#       tog-enclave

# ── Stage 1: build the enclave + convert/sign it ────────────────────────────
FROM rust:1.83-bookworm AS build

# Fortanix EDP toolchain.
RUN rustup target add x86_64-fortanix-unknown-sgx \
    && cargo install fortanix-sgx-tools sgxs-tools

WORKDIR /src
COPY . .

# Build only the enclave crate for the SGX target.
RUN cargo build --release -p tog-enclave --target x86_64-fortanix-unknown-sgx

# Convert ELF -> .sgxs using the layout from Cargo.toml's fortanix-sgx metadata.
# (elf2sgxs reads heap/stack/threads from that metadata when present.)
RUN ftxsgx-elf2sgxs \
        target/x86_64-fortanix-unknown-sgx/release/tog-enclave \
        --heap-size 2147483648 --stack-size 262144 --threads 16 --debug \
        --output /tog-enclave.sgxs

# Dev signing key. For production, sign with your real key (and register the
# resulting MRSIGNER with Enclave Manager) — DO NOT ship this throwaway key.
RUN sgxs-sign --key <(openssl genrsa -3 3072) /tog-enclave.sgxs /tog-enclave.sig --xfrm 7/0 || \
    (openssl genrsa -3 -out /signing-key.pem 3072 && \
     sgxs-sign --key /signing-key.pem /tog-enclave.sgxs /tog-enclave.sig)

# ── Stage 2: runtime with Intel SGX PSW/AESM + the Fortanix runner ──────────
FROM ubuntu:22.04 AS runtime

RUN apt-get update && apt-get install -y --no-install-recommends \
        curl gnupg ca-certificates \
    && curl -fsSL https://download.01.org/intel-sgx/sgx_repo/ubuntu/intel-sgx-deb.key \
        | gpg --dearmor -o /usr/share/keyrings/intel-sgx.gpg \
    && echo "deb [signed-by=/usr/share/keyrings/intel-sgx.gpg] https://download.01.org/intel-sgx/sgx_repo/ubuntu jammy main" \
        > /etc/apt/sources.list.d/intel-sgx.list \
    && apt-get update && apt-get install -y --no-install-recommends \
        libsgx-enclave-common \
        libsgx-urts \
        libsgx-quote-ex \
        libsgx-dcap-ql \
        libsgx-dcap-default-qpl \
        sgx-aesm-service \
    && rm -rf /var/lib/apt/lists/*

# The Fortanix runner that loads .sgxs into the enclave and serves its usercalls
# (this is what maps the enclave's TcpListener to a real host socket).
COPY --from=build /usr/local/cargo/bin/ftxsgx-runner /usr/local/bin/ftxsgx-runner
COPY --from=build /tog-enclave.sgxs /tog-enclave.sgxs
COPY --from=build /tog-enclave.sig  /tog-enclave.sig

EXPOSE 1546
# NOTE: AESM must be reachable (mount /var/run/aesmd) for quote generation, and
# the host must pass /dev/sgx_enclave + /dev/sgx_provision into the container.
ENTRYPOINT ["ftxsgx-runner", "/tog-enclave.sgxs"]
